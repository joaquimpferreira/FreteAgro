{
  "name": "fretagro-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:dev": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform android",
    "build:production": "eas build --profile production --platform android",
    "test": "jest --watchAll=false",
    "test:coverage": "jest --coverage",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo/vector-icons": "^14.1.0",
    "@fretagro/types": "workspace:*",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@supabase/supabase-js": "^2.47.0",
    "date-fns": "^3.6.0",
    "expo": "~51.0.28",
    "expo-crypto": "^13.0.2",
    "expo-haptics": "~13.0.1",
    "expo-image-manipulator": "~12.0.5",
    "expo-image-picker": "~15.0.7",
    "expo-linking": "~6.3.1",
    "expo-network": "~6.0.1",
    "expo-router": "~3.5.23",
    "expo-secure-store": "~13.0.2",
    "expo-splash-screen": "~0.27.6",
    "nativewind": "4.0.36",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-css-interop": "^0.0.36",
    "react-native-mmkv": "^2.12.2",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-url-polyfill": "^3.0.0",
    "zustand": "^4.5.6"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/react-native": "^12.5.1",
    "@types/react": "~18.2.79",
    "@types/react-native": "^0.73.0",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "^11.0.15",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.4",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.3.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@fretagro/types$": "<rootDir>/../packages/shared/types/index.ts"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(?:\\.pnpm/(?:[^/]*/)*)?(?:(?:jest-)?react-native|@react-native(?:-community)?|expo(?:nent)?|@expo(?:nent)?|@expo-google-fonts|react-navigation|@react-navigation|@unimodules|unimodules|sentry-expo|native-base|react-native-svg|nativewind))"
    ],
    "collectCoverageFrom": [
      "lib/**/*.{ts,tsx}",
      "hooks/**/*.{ts,tsx}",
      "!**/__tests__/**",
      "!**/*.d.ts"
    ]
  }
}
