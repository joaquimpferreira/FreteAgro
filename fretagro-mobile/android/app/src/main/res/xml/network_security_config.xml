<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration
  - debug-overrides: in DEBUG builds, also trust user-installed CA certificates.
    This allows the developer to install a corporate/proxy CA cert in the emulator
    (Settings → Security → Install a certificate) so HTTPS requests work through
    SSL-intercepting corporate proxies.
  - domain-config for 10.0.2.2/localhost: allows cleartext HTTP to the Metro
    bundler dev server (http://10.0.2.2:8081). 10.0.2.2 is the emulator's
    special alias for the host machine and never exists on real devices.
  - base-config: all other traffic requires HTTPS with system CAs only.
-->
<network-security-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
    <!-- Metro bundler runs over plain HTTP on the host machine -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
