<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY Network Security Configuration.

  This file lives in the `debug` source set and therefore REPLACES
  main/res/xml/network_security_config.xml for debug builds only.
  Release builds continue to use the strict main/ config (system CAs only).

  Why this exists:
    The development machine sits behind a Netskope SSL-intercepting corporate
    proxy. Netskope re-signs every HTTPS certificate (including Supabase) with
    its own private CA. The Android emulator does not trust that CA out of the
    box, so all HTTPS calls from the app (Supabase auth/sync) fail the TLS
    handshake with "Network request failed".

  Fix:
    We bundle the Netskope root + intermediate CA certificates as raw resources
    and add them as trust anchors for debug builds. This means NO per-developer
    emulator certificate install is required — any developer behind the same
    proxy can build the debug APK and HTTPS just works.

  Security:
    - Applies to DEBUG builds only (this source set is never part of release).
    - Release/production trust anchors remain system CAs only.
    - `user` is also trusted in debug so an individually installed corp cert
      (e.g. a different proxy) keeps working without editing this file.
-->
<network-security-config>
    <!-- Metro bundler runs over plain HTTP on the host machine (10.0.2.2 = host) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
            <!-- Netskope corporate proxy CA (debug only) -->
            <certificates src="@raw/netskope_ca_root" />
            <certificates src="@raw/netskope_ca_intermediate" />
        </trust-anchors>
    </base-config>
</network-security-config>
