# ──────────────────────────────────────────────────────────────────────────────
# FreteAgro Mobile — Environment Variables
# Copy this file to .env.local and fill in the real values.
# ──────────────────────────────────────────────────────────────────────────────
#
# O prefixo EXPO_PUBLIC_ é obrigatório: só assim a Expo injeta a variável no
# bundle do cliente (process.env). Use APENAS a anon key — nunca a service_role.
# O token de sessão do usuário é guardado em expo-secure-store, não aqui.

# URL do projeto Supabase (o MESMO usado pelo fretagro-web)
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave anônima pública do Supabase (segura para expor no cliente + RLS)
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
