{
  "name": "@fretagro/types",
  "version": "0.0.1",
  "private": true,
  "description": "Shared TypeScript types for FreteAgro monorepo",
  "main": "./types/index.ts",
  "types": "./types/index.ts",
  "exports": {
    ".": "./types/index.ts"
  },
  "scripts": {
    "test": "jest --watchAll=false",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": ".",
    "testMatch": ["**/__tests__/**/*.test.ts"],
    "collectCoverageFrom": [
      "lib/**/*.ts",
      "!**/*.d.ts"
    ]
  }
}
