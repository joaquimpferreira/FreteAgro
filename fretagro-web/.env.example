# ──────────────────────────────────────────────────────────────────────────────
# FreteAgro Web — Environment Variables
# Copy this file to .env.local and fill in the real values.
# Principle VII: every required variable documented with placeholders.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase Postgres, used by Prisma) ──────────────────────────────
# Use the Transaction Pooler URL (port 6543) for serverless/edge compatibility.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Direct connection URL — used by prisma migrate (no PgBouncer)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Supabase ──────────────────────────────────────────────────────────────────
# Intentionally NEXT_PUBLIC_* so the browser Supabase client can initialize.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ID.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Server-only — NEVER expose to the client bundle (Principle VI).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ── Next-Auth v5 ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ── WhatsApp Notifications (FR-006 — driver invite channel) ──────────────────
# Provider-agnostic: set these to your chosen provider (e.g. Twilio, Zapi, etc.)
# See lib/notifications/whatsapp.ts for the integration interface.
WHATSAPP_API_URL="https://api.your-whatsapp-provider.com/v1/messages"
WHATSAPP_API_TOKEN="your-whatsapp-api-token-here"
